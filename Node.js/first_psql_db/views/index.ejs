<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <style>
        #search {
            width: 300px;
            padding: 10px;
            margin-bottom: 20px;
            margin-left: 20px;
            border: 1px solid #ccc;
            border-radius: 4px;
        }
    </style>
</head>
<body>
    <form action="/" method="GET">
        <input type="text" id="search" name="search" placeholder="Search for a username...">
        <button type="submit">Search</button>
    </form>

    <p>USERNAMES: <%= usernames%></p>
    
</body>
</html>